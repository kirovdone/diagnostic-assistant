# Optional overrides. None of these is required: AWS credentials come from the standard
# chain (`aws configure`, `aws login`, AWS_PROFILE, or an instance role), never from here.
#
#   cp .env.example .env     # then edit, and never commit it — .gitignore covers .env
#
# Nothing loads .env by itself: pass it explicitly, e.g.
#   uv run --env-file .env uvicorn diagnostic_assist.api:app --port 8000

# Region and the models. `scripts/bedrock_models.py` prints what your account can call and
# whether these two ids are among them; it exits non-zero if not, so it works as a preflight.
# AWS_REGION=eu-central-1
# DIAGNOSTIC_ASSIST_BEDROCK_MODEL=eu.amazon.nova-lite-v1:0
# DIAGNOSTIC_ASSIST_BEDROCK_EMBEDDING_MODEL=eu.cohere.embed-v4:0

# Where the corpus and the hand-written gold labels live.
# DIAGNOSTIC_ASSIST_CASES_PATH=../sample_cases.json
# DIAGNOSTIC_ASSIST_GOLD_PATH=../gold_labels.json

# Signing key for session tokens. The fallback is a literal in a public repository and is
# therefore not a secret, which is why a deployment must set this. Rotating it invalidates
# every token in flight, which is the correct behaviour.
# DIAGNOSTIC_ASSIST_AUTH_SECRET=

# The seeded demo account's password, and the origins CORS allows.
# DIAGNOSTIC_ASSIST_USER_PASSWORD=
# DIAGNOSTIC_ASSIST_CORS_ORIGINS=http://localhost:3001,http://localhost:3002
